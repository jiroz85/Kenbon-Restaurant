# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=kenbon
DB_PASSWORD=kenbon
DB_NAME=kenbon_restaurant

# JWT
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_token_secret_different_from_above

# Email Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Development (Gmail)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Production SMTP (replace with your email service)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Alternative: Use same variables for both environments
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
